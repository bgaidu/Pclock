@echo off
setlocal
cd /d "%~dp0"

rem Generate src\_Version.cs (provides AppVersion.Version / AppVersion.Commit).
rem Single source of truth: both build.bat and PCLock.csproj (BeforeBuild) call
rem this script, so the generation logic cannot drift between them.
rem The output is git-ignored (see .gitignore) and must never be committed.
rem NOTE: keep this file pure ASCII - cmd.exe reads batch files using the
rem system ANSI code page (GBK on zh-CN Windows), and UTF-8 CJK bytes can be
rem mis-parsed into control characters.

set GITSHA=local
for /f "delims=" %%i in ('git rev-parse --short HEAD 2^>nul') do set GITSHA=%%i

>src\_Version.cs echo // auto-generated by gen_version.bat - version tracks git commit
>>src\_Version.cs echo namespace PCLock
>>src\_Version.cs echo {
>>src\_Version.cs echo     internal static class AppVersion
>>src\_Version.cs echo     {
>>src\_Version.cs echo         public const string Version = "1.0.0";
>>src\_Version.cs echo         public const string Commit = "%GITSHA%";
>>src\_Version.cs echo     }
>>src\_Version.cs echo }

endlocal
exit /b 0
