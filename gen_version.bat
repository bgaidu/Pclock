@echo off
setlocal EnableDelayedExpansion
cd /d "%~dp0"

rem Generate src\_Version.cs (provides AppVersion.Version / AppVersion.Commit).
rem Single source of truth: both build.bat and PCLock.csproj (BeforeBuild) call
rem this script, so the generation logic cannot drift between them.
rem The output is git-ignored (see .gitignore) and must never be committed.
rem
rem Version is derived automatically from the current git tag on EVERY build:
rem   1) GitHub Actions tag build -> GITHUB_REF_NAME (exact tag, e.g. v1.6.0)
rem   2) Local build              -> exact tag at HEAD, else nearest reachable tag
rem   3) No tag / no git          -> fallback 1.0.0 (Commit falls back to "local")
rem A leading v/V is stripped because the UI prints "v" + AppVersion.Version.
rem
rem Delayed expansion is required, and the lookup is deliberately FLAT (goto
rem instead of nested parenthesized blocks): a for /f nested inside an if block
rem silently fails to capture git output with cmd.exe.
rem
rem NOTE: keep this file pure ASCII - cmd.exe reads batch files using the
rem system ANSI code page (GBK on zh-CN Windows), and UTF-8 CJK bytes can be
rem mis-parsed into control characters.

set VERSION=1.0.0
set GITSHA=local
set HEADTAG=

rem CI: a tag-triggered release build wins over any local tag lookup.
if /I "!GITHUB_REF_TYPE!"=="tag" if not "!GITHUB_REF_NAME!"=="" set VERSION=!GITHUB_REF_NAME!
if /I "!GITHUB_REF_TYPE!"=="tag" if not "!GITHUB_REF_NAME!"=="" goto :gotversion

rem Local: exact tag at HEAD (annotated tags included).
for /f "delims=" %%i in ('git tag --points-at HEAD 2^>nul') do set HEADTAG=%%i
if not "!HEADTAG!"=="" set VERSION=!HEADTAG!
if not "!VERSION!"=="1.0.0" goto :gotversion

rem Local: otherwise the highest-version tag known to this clone.
rem NOTE: do not use "git describe --abbrev=0" here - cmd.exe splits on "="
rem and git receives "0" as an object name ("Not a valid object name 0").
set NEAREST=
for /f "delims=" %%i in ('git tag --list --sort=-version:refname 2^>nul') do if not defined NEAREST set NEAREST=%%i
if not "!NEAREST!"=="" set VERSION=!NEAREST!

:gotversion
if /I "!VERSION:~0,1!"=="v" set VERSION=!VERSION:~1!
for /f "delims=" %%i in ('git rev-parse --short HEAD 2^>nul') do set GITSHA=%%i

>src\_Version.cs echo // auto-generated by gen_version.bat - version tracks the current git tag
>>src\_Version.cs echo namespace PCLock
>>src\_Version.cs echo {
>>src\_Version.cs echo     internal static class AppVersion
>>src\_Version.cs echo     {
>>src\_Version.cs echo         public const string Version = "!VERSION!";
>>src\_Version.cs echo         public const string Commit = "!GITSHA!";
>>src\_Version.cs echo     }
>>src\_Version.cs echo }

endlocal
exit /b 0
